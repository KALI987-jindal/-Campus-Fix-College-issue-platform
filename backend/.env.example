# CampusFix Backend — Environment Variables Template
# =====================================================
# Copy this file to .env and fill in real values:
#   cp .env.example .env
#
# The .env file is git-ignored and must NEVER be committed.
# =====================================================

# ── JWT Secret Key ─────────────────────────────────────────────────────────
# Generate a strong secret with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Replace the placeholder below with your generated value.
SECRET_KEY=REPLACE_WITH_A_STRONG_RANDOM_SECRET_DO_NOT_USE_THIS_VALUE

# ── Database URL (optional) ────────────────────────────────────────────────
# Defaults to SQLite at backend/campus_fix.db when not set.
# For PostgreSQL: postgresql://user:password@localhost:5432/campusfix
# DATABASE_URL=sqlite:///./campus_fix.db
